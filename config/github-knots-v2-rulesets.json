{
  "schema_version": 1,
  "repository": "acartine/knots",
  "phases": {
    "authority_code": [
      {
        "name": "knots-v2-authority-code-immutable",
        "patterns": ["refs/heads/knots-v2-authority-code/*"],
        "rules": ["update", "deletion", "non_fast_forward"]
      }
    ],
    "canary": [
      {
        "name": "knots-v2-canary-immutable",
        "patterns": [
          "refs/heads/knots-v2-canary/immutable/*",
          "refs/heads/knots-v2-canary/control/epochs/**/*"
        ],
        "rules": ["update", "deletion", "non_fast_forward"]
      }
    ],
    "production": [
      {
        "name": "knots-v2-legacy-freeze",
        "enforcement": "disabled",
        "patterns": ["refs/heads/knots"],
        "rules": ["creation", "update", "deletion", "non_fast_forward"]
      },
      {
        "name": "knots-v2-control-epochs",
        "patterns": ["refs/heads/knots-v2-control/epochs/**/*"],
        "rules": ["update", "deletion", "non_fast_forward"]
      },
      {
        "name": "knots-v2-immutable-generations",
        "patterns": [
          "refs/heads/knots-v2-canonical/**/*",
          "refs/heads/knots-v2-archive/**/*"
        ],
        "rules": ["update", "deletion", "non_fast_forward"]
      },
      {
        "name": "knots-v2-immutable-proposals",
        "patterns": ["refs/heads/knots-v2-proposals/*/*/*"],
        "rules": ["update", "deletion", "non_fast_forward"]
      }
    ]
  }
}
